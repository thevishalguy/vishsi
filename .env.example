# VishSi — optional overrides.
#
# The two things you normally need are NOT here:
#   api_key.txt    your API key    (one line, # comments allowed)
#   endpoint.txt   your base URL   (one line, optional 2nd line = model id)
# Create them with `npm run setup`. Both are re-read on every request.

# Backend port (the Vite dev server proxies /api and /ws here)
PORT=5174

# Workspace folder opened on boot. Leave unset to open the VishSi folder
# itself; any folder can be mounted from the UI at runtime.
# WORKSPACE_ROOT=C:\path\to\your\project

# --- Overrides (each one wins over the .txt files) --------------------------
# API_KEY=
# API_KEY_FILE=C:\path\to\some\other\key.txt   (used only if api_key.txt is empty)
# BASE_URL=https://integrate.api.nvidia.com/v1 (used only if endpoint.txt is empty)
# MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# PROVIDER=openai       # or "anthropic"; auto-detected from the endpoint otherwise

# --- Browser tool -----------------------------------------------------------
# playwright-core drives a Chromium-family browser already on the machine.
# Leave blank to auto-detect Edge/Chrome, or set an explicit path.
# BROWSER_EXECUTABLE=

# UI (Vite dev server) port. If it is taken, Vite moves to the next free port.
# UI_PORT=5173
