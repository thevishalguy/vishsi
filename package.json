{
  "name": "vishsi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first agentic IDE and workspace UI (Claude Code inspired). Node + npm only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "setup": "node server/setup.js",
    "preflight": "node server/preflight.js"
  },
  "comment:overrides": "Windows Application Control on this machine blocks rollup's native .node addon (ERR_DLOPEN_FAILED). The WASM build of rollup is pure JS and loads fine. Remove this override on machines where the native binary is allowed.",
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.30.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@uiw/codemirror-theme-github": "^4.23.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "diff": "^5.2.0",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "playwright-core": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
